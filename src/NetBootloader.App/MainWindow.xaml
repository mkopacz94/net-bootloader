<Window x:Class="NetBootloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetBootloader.App.ViewModels"
        xmlns:views="clr-namespace:NetBootloader.App.Views"
        xmlns:loc="clr-namespace:NetBootloader.App.Localization"
        Title="Net Bootloader" Height="720" Width="720" MinHeight="360" MinWidth="480">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Everything scrolls as one column instead of the window enforcing a tall
         minimum height, so the app stays usable on small screens (laptops, small
         external displays) where that much vertical space isn't a given. The log's
         own TextBox (FlashLogView) keeps a fixed height and its own scrollbar, so it
         doesn't try to grow to fit its entire (potentially huge) contents here. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <!-- Language picker: shows just the current language's flag when closed;
                 clicking it (standard ComboBox click-to-open - no custom handling
                 needed) reveals the dropdown with flag + name per language. The
                 "closed" and "open" states use different DataTemplates
                 (SelectionBoxItemTemplate vs. ItemTemplate) - this app's own
                 ComboBox ControlTemplate in Themes/Controls.xaml already wires
                 SelectionBoxItemTemplate through, it just wasn't used until now.
                 Bound to Localization.Strings.Instance directly (not the window's
                 own DataContext), so it lives independently of anything else the
                 app is doing. -->
            <ComboBox HorizontalAlignment="Right" Margin="0,0,0,12" Width="60"
                      ItemsSource="{Binding AvailableLanguages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      ToolTip="{Binding Source={x:Static loc:Strings.Instance}, Path=LanguagePickerTooltip}">
                <ComboBox.SelectionBoxItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Flag}" FontFamily="Segoe UI Emoji" FontSize="18" />
                    </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Flag}" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <views:ConnectionView DataContext="{Binding Connection}" Margin="0,0,0,16" />

            <views:FirmwareView DataContext="{Binding Firmware}" Margin="0,0,0,16" />

            <!-- Actions row - stays bound to MainViewModel, since Flash/Cancel need data
                 from both Connection and Firmware. -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=FlashButton}"
                        Command="{Binding FlashCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="1" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=CancelButton}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" />
            </Grid>

            <views:FlashLogView DataContext="{Binding Log}" />
        </StackPanel>
    </ScrollViewer>
</Window>
