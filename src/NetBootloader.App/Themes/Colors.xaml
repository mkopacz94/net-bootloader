<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="Color.Primary">#6bb8ff</Color>
    <Color x:Key="Color.Primary.MouseOver">#7bbfff</Color>
    <Color x:Key="Color.Primary.Pressed">#5db1ff</Color>

    <Color x:Key="Color.Secondary">#e86ab5</Color>
    <Color x:Key="Color.Secondary.MouseOver">#ee74bd</Color>
    <Color x:Key="Color.Secondary.Pressed">#e15cab</Color>

    <Color x:Key="Color.FontDark">#4a4f63</Color>
    <Color x:Key="Color.FontMuted">#8d92a6</Color>

    <!-- Neutrals to round out the palette above into a full light UI -->
    <Color x:Key="Color.Background">#f4f6fb</Color>
    <Color x:Key="Color.Surface">#ffffff</Color>
    <Color x:Key="Color.Border">#e2e6f0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Primary.MouseOver" Color="{StaticResource Color.Primary.MouseOver}" />
    <SolidColorBrush x:Key="Brush.Primary.Pressed" Color="{StaticResource Color.Primary.Pressed}" />

    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}" />
    <SolidColorBrush x:Key="Brush.Secondary.MouseOver" Color="{StaticResource Color.Secondary.MouseOver}" />
    <SolidColorBrush x:Key="Brush.Secondary.Pressed" Color="{StaticResource Color.Secondary.Pressed}" />

    <SolidColorBrush x:Key="Brush.FontDark" Color="{StaticResource Color.FontDark}" />
    <SolidColorBrush x:Key="Brush.FontMuted" Color="{StaticResource Color.FontMuted}" />

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />

</ResourceDictionary>
