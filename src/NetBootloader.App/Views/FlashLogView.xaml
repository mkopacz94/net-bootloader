<UserControl x:Class="NetBootloader.App.Views.FlashLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NetBootloader.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FlashLogViewModel}">
    <StackPanel>
        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100" />
        <TextBlock Text="{Binding StatusText}" Margin="0,4,0,12" />

        <GroupBox Header="Log">
            <!-- Fixed Height, not Auto: this view now lives inside MainWindow's
                 ScrollViewer, which hands its content unbounded height. Without an
                 explicit bound here, this TextBox (which can hold thousands of lines
                 for a full flash) would grow to fit all of them instead of scrolling
                 within its own compact viewport. -->
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     Height="220"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" TextWrapping="NoWrap" />
        </GroupBox>
    </StackPanel>
</UserControl>
