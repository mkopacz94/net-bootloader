<Window x:Class="NetBootloader.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NetBootloader.App.Localization"
        Title="Net Bootloader"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MaxWidth="440">
    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#1a1f36" BlurRadius="24" ShadowDepth="4" Opacity="0.18" />
        </Border.Effect>
        <StackPanel MinWidth="320" MaxWidth="392">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="{StaticResource Brush.Danger}"
                        Margin="0,0,12,0">
                    <TextBlock Text="!" FontWeight="Bold" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleTextBlock" FontWeight="SemiBold" FontSize="15"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Margin="0,0,0,20" />

            <Button x:Name="OkButton"
                    Content="{Binding Source={x:Static loc:Strings.Instance}, Path=OkButton}"
                    Click="OkButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" MinWidth="88" />
        </StackPanel>
    </Border>
</Window>
