<UserControl x:Class="NetBootloader.App.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NetBootloader.App.ViewModels"
             xmlns:loc="clr-namespace:NetBootloader.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoftwareViewModel}">
    <UserControl.Resources>
        <!-- Local to this view rather than Themes/Controls.xaml: no other ListBox exists
             in the app yet, so a global restyle isn't worth the risk of an unintended
             side effect elsewhere. Mirrors ComboBoxItem's style in Controls.xaml so the
             catalog list reads as part of the same rounded, card-based theme. -->
        <Style x:Key="SoftwareListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Margin="0,0,0,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource Brush.Background}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <GroupBox Header="{Binding Source={x:Static loc:Strings.Instance}, Path=SoftwareHeader}">
        <StackPanel>
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                <!-- MaxHeight forces internal scrolling instead of growing to fit the
                     whole catalog - same reasoning as FlashLogView's fixed-height log box
                     (see README): this sits inside MainWindow's own outer ScrollViewer. -->
                <ListBox ItemsSource="{Binding AvailableSoftware}"
                         SelectedItem="{Binding SelectedSoftware}"
                         ItemContainerStyle="{StaticResource SoftwareListBoxItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         MaxHeight="180"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Version}" Margin="8,0,0,0" Opacity="0.7" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource Brush.Secondary}" CornerRadius="4"
                                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBeta}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=SoftwareBetaBadge}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <!-- Downloaded-and-ready-to-flash indicator: a small green
                                     checkmark badge, reusing the same check glyph geometry
                                     as the app's CheckBox style (Themes/Controls.xaml) so it
                                     reads as the same "checked" affordance. Stays visible for
                                     an entry regardless of current selection, since
                                     SoftwareViewModel caches downloads per entry rather than
                                     clearing them when the selection moves elsewhere. -->
                                <Border Grid.Column="1" Width="16" Height="16" CornerRadius="8"
                                        Background="{StaticResource Brush.Success}"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip="{Binding Source={x:Static loc:Strings.Instance}, Path=SoftwareDownloadedTooltip}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Data="M1,4.2 L4,7 L9,1" Stroke="White" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stretch="Uniform" Width="9" Height="7"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding ReleaseDate, StringFormat=d}"
                                           Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="{Binding Source={x:Static loc:Strings.Instance}, Path=SoftwareEmptyCatalog}"
                       HorizontalAlignment="Center" Opacity="0.6" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AvailableSoftware.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DownloadedLabel}" VerticalAlignment="Center" Opacity="0.7" />
                <Button Grid.Column="1" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=RefreshButton}"
                        Command="{Binding LoadAvailableSoftwareCommand}"
                        Margin="6,0,0,0" Padding="8,2" />
                <Button Grid.Column="2" Content="{Binding Source={x:Static loc:Strings.Instance}, Path=DownloadButton}"
                        Command="{Binding DownloadSoftwareCommand}"
                        Margin="6,0,0,0" Padding="8,2" />
            </Grid>
        </StackPanel>
    </GroupBox>
</UserControl>
